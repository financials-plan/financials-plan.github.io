rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidDocId(id) {
      return id is string;
    }

    match /financial_Authentication/{docId} {
      allow read, write: if true || docId == 'groups';

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /classes/{classId} {
      allow read, write: if true;
      allow delete: if isValidDocId(classId);

      match /submissions/{studentUsername} {
        allow read, write: if true;
      }

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /groups/{groupId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /group_codes/{code} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /student_plans/{planId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /user_states/{stateId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /financial_data/{docId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /financial_accounts/{username} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /users/{username} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /accounts/{username} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /admin_codes/{code} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /keywords/{keywordId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /setup_keywords/{docId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /student_keywords/{username} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /keywords_config/{configId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
