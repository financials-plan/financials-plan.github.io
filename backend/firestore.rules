rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidDocId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function canDeleteDoc(id) {
      return isValidDocId(id) && request.auth != null;
    }

    function isOwner(userId) {
      return isValidDocId(userId) && request.auth != null && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    function fitsKeys(maxKeys) {
      return request.resource.data is map && request.resource.data.keys().size() <= maxKeys;
    }

    match /financial_Authentication/{docId} {
      allow get: if isValidDocId(docId);
      allow create, update: if isValidDocId(docId) && fitsKeys(60);
      allow delete: if canDeleteDoc(docId);
    }

    match /classes/{classId} {
      allow get: if isValidDocId(classId);
      allow list: if true;
      allow create, update: if isValidDocId(classId) && fitsKeys(80);
      allow delete: if isValidDocId(classId);

      match /submissions/{studentUsername} {
        allow get: if isValidDocId(studentUsername);
        allow create, update: if isValidDocId(studentUsername) && fitsKeys(80);
        allow delete: if isValidDocId(studentUsername);
      }
    }

    match /student_plans/{planId} {
      allow get: if isValidDocId(planId);
      allow create, update: if isValidDocId(planId) && fitsKeys(200);
      allow delete: if isOwner(planId);
    }

    function hasNoPlainSecrets() {
      return !request.resource.data.keys().hasAny(['password', 'mat_khau', 'isSeed']);
    }

    function keepsPbkdf2() {
      let pbkdf2 = 'pbkdf2-sha256';
      let newAlgo = request.resource.data.get('hashAlgo', '');
      return (resource.data.get('hashAlgo', '') != pbkdf2 || newAlgo == pbkdf2)
        && (request.resource.data.get('passHash', '') == resource.data.get('passHash', '') || newAlgo == pbkdf2);
    }

    match /financial_accounts/{username} {
      allow get: if isValidDocId(username);
      allow create: if isValidDocId(username) && fitsKeys(60) && hasNoPlainSecrets();
      allow update: if isValidDocId(username) && fitsKeys(60) && hasNoPlainSecrets() && keepsPbkdf2();
      allow delete: if isOwner(username);
    }

    match /admin_codes/{code} {
      allow get: if isValidDocId(code);
      allow list: if true;
      allow create, update: if isValidDocId(code) && fitsKeys(40);
      allow delete: if canDeleteDoc(code);
    }
  }
}
