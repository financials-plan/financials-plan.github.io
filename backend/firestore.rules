rules_version = '2';

// Mục tiêu tối ưu chi phí/dung lượng (KHÔNG nới quyền so với bản trước):
// - Chỉ khai báo các collection app thật sự dùng; mọi đường dẫn khác bị từ chối mặc định
//   (bản cũ cho đọc công khai toàn bộ `/{document=**}` -> ai cũng quét được cả database).
// - Bỏ các collection/subcollection không còn dùng (financial_data, user_states, keywords,
//   keywords_config) để không ai có thể ghi rác làm phình dung lượng.
// - Mỗi lần ghi phải là một map hợp lệ và không quá số trường tối đa của từng loại tài liệu,
//   chặn việc ghi tài liệu phình to bất thường.
// Lưu ý: app tự quản tài khoản (chưa dùng Firebase Authentication) nên quyền ghi vẫn mở; xem SECURITY.md mục 8b.

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidDocId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function canDeleteDoc(id) {
      return isValidDocId(id) && request.auth != null;
    }

    function isOwner(userId) {
      return isValidDocId(userId) && request.auth != null && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    function fitsKeys(maxKeys) {
      return request.resource.data is map && request.resource.data.keys().size() <= maxKeys;
    }

    match /financial_Authentication/{docId} {
      allow read: if isValidDocId(docId);
      allow create, update: if isValidDocId(docId) && fitsKeys(60);
      allow delete: if canDeleteDoc(docId);
    }

    match /classes/{classId} {
      allow read: if isValidDocId(classId);
      allow create, update: if isValidDocId(classId) && fitsKeys(80);
      allow delete: if isValidDocId(classId);

      match /submissions/{studentUsername} {
        allow read: if isValidDocId(studentUsername);
        allow create, update: if isValidDocId(studentUsername) && fitsKeys(80);
        allow delete: if isOwner(studentUsername);
      }
    }

    match /groups/{groupId} {
      allow read: if isValidDocId(groupId);
      allow create, update: if isValidDocId(groupId) && fitsKeys(80);
      allow delete: if isValidDocId(groupId);
    }

    match /group_codes/{code} {
      allow read: if isValidDocId(code);
      allow create, update: if isValidDocId(code) && fitsKeys(40);
      allow delete: if canDeleteDoc(code);
    }

    match /student_plans/{planId} {
      allow read: if isValidDocId(planId);
      allow create, update: if isValidDocId(planId) && fitsKeys(200);
      allow delete: if isOwner(planId);
    }

    match /financial_accounts/{username} {
      allow read: if isValidDocId(username);
      allow create, update: if isValidDocId(username) && fitsKeys(60);
      allow delete: if isOwner(username);
    }

    match /users/{username} {
      allow read: if isValidDocId(username);
      allow create, update: if isValidDocId(username) && fitsKeys(60);
      allow delete: if isOwner(username);
    }

    match /accounts/{username} {
      allow read: if isValidDocId(username);
      allow create, update: if isValidDocId(username) && fitsKeys(60);
      allow delete: if isOwner(username);
    }

    match /admin_codes/{code} {
      allow read: if isValidDocId(code);
      allow create, update: if isValidDocId(code) && fitsKeys(40);
      allow delete: if canDeleteDoc(code);
    }

    match /setup_keywords/{docId} {
      allow read: if isValidDocId(docId);
      allow create, update: if isValidDocId(docId) && fitsKeys(200);
      allow delete: if canDeleteDoc(docId);
    }

    match /student_keywords/{username} {
      allow read: if isValidDocId(username);
      allow create, update: if isValidDocId(username) && fitsKeys(200);
      allow delete: if isOwner(username);
    }
  }
}
