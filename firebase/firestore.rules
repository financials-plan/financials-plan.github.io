rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidUserProfileId(docId) {
      return docId == 'khach_hang_mac_dinh'
          || docId.matches('^user_[a-z0-9_.]{2,80}$');
    }

    function isAuthenticatedUser() {
      return request.auth != null && request.auth.uid != null && request.auth.uid.size() > 0;
    }

    function isAuthorizedForDocId(docId) {
      return isAuthenticatedUser()
          && (!('docId' in request.auth.token) || request.auth.token.docId == docId);
    }

    function isDocumentOwner(resourceData) {
      return isAuthenticatedUser()
          && resourceData != null
          && 'owner_uid' in resourceData
          && resourceData.owner_uid == request.auth.uid;
    }

    function isUnclaimedLegacyDocument(resourceData) {
      return resourceData == null
          || !('owner_uid' in resourceData)
          || resourceData.owner_uid == null
          || resourceData.owner_uid == '';
    }

    function hasValidOwnerAssignment(newData, existingData) {
      return isAuthenticatedUser()
          && 'owner_uid' in newData
          && newData.owner_uid == request.auth.uid
          && (existingData == null
              || !('owner_uid' in existingData)
              || existingData.owner_uid == null
              || existingData.owner_uid == ''
              || existingData.owner_uid == request.auth.uid);
    }

    function hasValidFinancialPayload(data) {
      return data.keys().hasAll(['_lastUpdated', 'owner_uid'])
          && data._lastUpdated is string
          && data._lastUpdated.size() <= 64
          && data.owner_uid is string
          && data.owner_uid.size() >= 1
          && data.owner_uid.size() <= 128
          && (!('password' in data))
          && (!('passwordHash' in data))
          && (!('ho_ten' in data) || (data.ho_ten is string && data.ho_ten.size() >= 1 && data.ho_ten.size() <= 120))
          && (!('username' in data) || (data.username is string && data.username.size() >= 2 && data.username.size() <= 64))
          && (!('currentYear' in data) || (data.currentYear is number && data.currentYear >= 1900 && data.currentYear <= 2200))
          && (!('currentAge' in data) || (data.currentAge is number && data.currentAge >= 0 && data.currentAge <= 150))
          && (!('_backups' in data) || (data._backups is list && data._backups.size() <= 30))
          && request.resource.size < 950000;
    }

    match /financial_accounts/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    match /financial_Authentication/{docId} {
      allow get: if isValidUserProfileId(docId);
      allow list: if false;
      allow create: if isValidUserProfileId(docId) && hasValidFinancialPayload(request.resource.data);
      allow update: if isValidUserProfileId(docId) && hasValidFinancialPayload(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
